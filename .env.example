# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...

# ── ElevenLabs (agente de voz + batch calling) ──
ELEVENLABS_API_KEY=...
ELEVENLABS_AGENT_ID=...
ELEVENLABS_PHONE_NUMBER_ID=...   # número/telefonía conectada en ElevenLabs

# ── Twilio (telefonía POC, número España) ──
TWILIO_ACCOUNT_SID=...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+34...

# ── Transferencia a humano (Salida 3) ──
EINFORMA_CALLCENTER_NUMBER=+34900...

# ── Email (Salida 2) ──
RESEND_API_KEY=...
EMAIL_FROM=eInforma <noreply@informa.es>

# ── Seguridad de webhooks ──
# Secreto compartido para verificar los webhooks del agente (tools + post-llamada).
# Si se define, los endpoints /api/tools/* y /api/webhooks/elevenlabs exigen
# la cabecera `x-webhook-secret: <este valor>` (añádela en cada tool de ElevenLabs)
# o una firma HMAC `elevenlabs-signature` válida. Si se deja vacío, NO se verifica
# (solo aceptable en desarrollo). Definir antes de campañas reales.
WEBHOOK_SHARED_SECRET=
